# TD 6.2.2 Release_2026.1_SP2, PH1A90SEG324 -2 full source build.
# argv = projectPath ?configurationPath?; clone's build_direct.tcl supplies argv.
# Windows CLI itself receives only the caller script path, not extra arguments.
# Configuration is generated by td_reuse.py audit --project ... --direct-config ...
# No managed run launches, old checkpoint imports or synthesized process markers.

set td_direct_stage initialize
set td_direct_out ""
# A design without async_reg chains legitimately has no MTBF report.
# A generated config can make this mandatory for a particular CDC acceptance.
set td_direct_mtbf_mandatory 0
set td_direct_fix_hold_high 0
proc td_direct_binary {path} {
    set f [open $path rb]
    set value [read $f]
    close $f
    return $value
}
proc td_direct_mark {stage} {
    global td_direct_stage td_direct_out
    set td_direct_stage $stage
    puts "DIRECT_BUILD_STAGE=$stage"
    set f [open [file join $td_direct_out build.stage] w]
    puts $f $stage
    close $f
}
proc td_direct_require {path} {
    global td_direct_started
    if {![file isfile $path] || [file size $path] == 0} {
        error "Missing/empty output: $path"
    }
    if {[file mtime $path] < $td_direct_started} {
        error "Output predates this build: $path"
    }
}
proc td_direct_read_user_constraint {kind path} {
    # Log and validate the actual argument immediately before entering TD's
    # native parser; Tcl filesystem staging alone cannot prove this boundary.
    if {[string trim $path] eq "" || ![file isfile $path]} {
        error "Empty/missing $kind constraint after TD project analysis: <$path>"
    }
    set path [file normalize $path]
    puts "DIRECT_BUILD_READ_[string toupper $kind]=<$path> bytes=[file size $path]"
    if {$kind eq "adc"} {
        eval [list read_adc -file $path]
    } elseif {$kind eq "sdc"} {
        eval [list read_sdc $path]
    } else {error "Unknown user constraint type: $kind"}
}

if {[catch {
    if {![info exists argv] || [llength $argv] < 1 || [llength $argv] > 2} {
        error "Expected argv: projectPath ?configurationPath?; use clone build_direct.tcl on Windows"
    }
    set td_direct_input [file normalize [lindex $argv 0]]
    if {[string tolower [file extension $td_direct_input]] ne ".al"} {
        error "Use the current .al project; generated run .prj files may have stale dependencies"
    }
    if {[llength $argv] == 2} {
        set td_direct_config [file normalize [lindex $argv 1]]
    } else {
        set td_direct_config [file join [file dirname $td_direct_input] build_direct_config.tcl]
    }
    if {![file isfile $td_direct_input] || ![file isfile $td_direct_config]} {
        error "Missing project/configuration; generate configuration with td_reuse.py audit"
    }
    source -encoding utf-8 $td_direct_config
    foreach td_direct_key {schema project project_sha256 project_size project_mtime name top
            device_db package speed syn_run phy_run area_option adc sdc ip_adc ip_sdc stage_files} {
        if {![info exists td_direct_$td_direct_key]} {
            error "Missing configuration field: $td_direct_key"
        }
    }
    if {$td_direct_schema != 2 || [file normalize $td_direct_project] ne $td_direct_input} {
        error "Configuration belongs to a different project or schema"
    }
    if {[file size $td_direct_input] != $td_direct_project_size ||
            [file mtime $td_direct_input] != $td_direct_project_mtime} {
        error "Project changed since configuration generation; rerun audit --direct-config"
    }
    if {$td_direct_package ne "PH1A90SEG324" || $td_direct_speed != 2 ||
            $td_direct_device_db ne "ph1_90.db"} {
        error "Unsupported device; template is scoped to PH1A90SEG324 -2"
    }
    if {$td_direct_area_option ni {-packarea -maparea}} {
        error "Unsupported optimize_gate area option"
    }
    foreach td_direct_constraint [concat $td_direct_adc $td_direct_sdc] {
        if {![file isfile $td_direct_constraint]} {error "Missing constraint: $td_direct_constraint"}
    }
    foreach td_direct_pair [concat $td_direct_ip_adc $td_direct_ip_sdc] {
        if {[llength $td_direct_pair] != 2 || ![file isfile [lindex $td_direct_pair 1]]} {
            error "Invalid IP model/constraint pair: $td_direct_pair"
        }
    }
    set td_direct_started [clock seconds]
    set td_direct_stamp [clock format $td_direct_started -format %Y%m%d_%H%M%S]
    set td_direct_out [file join [file dirname $td_direct_input] reports direct_build_${td_direct_stamp}_[pid]]
    if {[file exists $td_direct_out]} {error "Refusing an existing output directory: $td_direct_out"}
    set td_direct_before [td_direct_binary $td_direct_input]
    file mkdir $td_direct_out
    file copy $td_direct_config [file join $td_direct_out build.inputs.tcl]
    puts "DIRECT_BUILD_OUTPUT=$td_direct_out"
    puts "DIRECT_BUILD_PROJECT=$td_direct_input"
    puts "DIRECT_BUILD_SOURCE_SHA256=$td_direct_project_sha256"
    # TD loads IPC/XML and native ROM files at different stages, resolving
    # relative paths against cwd. Keep ALL commands in a fresh, complete source
    # snapshot: changing cwd after open_project is insufficient for ROM files.
    set td_direct_input_root [file dirname $td_direct_input]
    set td_direct_stage_manifest [open [file join $td_direct_out staged.inputs.tsv] w]
    puts $td_direct_stage_manifest "relative_path\tsize\tmtime\tconfiguration_sha256\tcopy_check"
    foreach td_direct_entry $td_direct_stage_files {
        lassign $td_direct_entry td_direct_rel td_direct_size td_direct_mtime td_direct_sha
        if {[llength $td_direct_entry] != 4 || [file pathtype $td_direct_rel] ne "relative" ||
                ".." in [file split $td_direct_rel]} {
            error "Invalid staging dependency: $td_direct_entry"
        }
        set td_direct_from [file join $td_direct_input_root $td_direct_rel]
        set td_direct_to [file join $td_direct_out $td_direct_rel]
        if {![file isfile $td_direct_from] || [file size $td_direct_from] != $td_direct_size ||
                [file mtime $td_direct_from] != $td_direct_mtime} {
            error "Source changed since configuration generation: $td_direct_from; rerun audit"
        }
        file mkdir [file dirname $td_direct_to]
        file copy $td_direct_from $td_direct_to
        if {[td_direct_binary $td_direct_from] ne [td_direct_binary $td_direct_to]} {
            error "Staged source differs from input: $td_direct_from"
        }
        puts $td_direct_stage_manifest "$td_direct_rel\t$td_direct_size\t$td_direct_mtime\t$td_direct_sha\tBINARY_IDENTICAL"
    }
    close $td_direct_stage_manifest
    set td_direct_staged_project [file join $td_direct_out [file tail $td_direct_input]]
    # Relocate only this private .al copy, preserving TD's literal XML spelling.
    set td_direct_f [open $td_direct_staged_project r]
    fconfigure $td_direct_f -encoding utf-8
    set td_direct_al_text [read $td_direct_f]
    close $td_direct_f
    set td_direct_al_text [string map [list $td_direct_input_root $td_direct_out \
            [string map {/ \\} $td_direct_input_root] $td_direct_out] $td_direct_al_text]
    set td_direct_xml_out [string map [list & {&amp;} \" {&quot;}] $td_direct_out]
    if {![regexp -indices {(<Project\s[^>]*\sPath=")[^"]*} $td_direct_al_text td_direct_match td_direct_prefix]} {
        error "Cannot relocate staged .al Project Path"
    }
    set td_direct_al_text [string replace $td_direct_al_text \
        [expr {[lindex $td_direct_prefix 1] + 1}] [lindex $td_direct_match 1] $td_direct_xml_out]
    set td_direct_f [open $td_direct_staged_project w]
    fconfigure $td_direct_f -encoding utf-8 -translation lf
    puts -nonewline $td_direct_f $td_direct_al_text
    close $td_direct_f
    foreach td_direct_kind {adc sdc} {
        set td_direct_relocated {}
        foreach td_direct_path [set td_direct_$td_direct_kind] {
            lappend td_direct_relocated [string map [list $td_direct_input_root $td_direct_out] $td_direct_path]
        }
        set td_direct_$td_direct_kind $td_direct_relocated
    }
    foreach td_direct_kind {ip_adc ip_sdc} {
        set td_direct_relocated {}
        foreach td_direct_pair [set td_direct_$td_direct_kind] {
            lappend td_direct_relocated [list [lindex $td_direct_pair 0] \
                [string map [list $td_direct_input_root $td_direct_out] [lindex $td_direct_pair 1]]]
        }
        set td_direct_$td_direct_kind $td_direct_relocated
    }
    set td_direct_meta [open [file join $td_direct_out source_snapshot.status] w]
    puts $td_direct_meta "input_source=$td_direct_input"
    puts $td_direct_meta "staged_project=$td_direct_staged_project"
    puts $td_direct_meta "input_al_sha256=$td_direct_project_sha256"
    puts $td_direct_meta "All listed source copies were checked byte-for-byte; hashes are configuration-time provenance."
    close $td_direct_meta
    puts "DIRECT_BUILD_STAGED_PROJECT=$td_direct_staged_project"
    set td_direct_frozen_user_constraints [list $td_direct_adc $td_direct_sdc]
    puts "DIRECT_BUILD_STAGED_USER_CONSTRAINTS=$td_direct_frozen_user_constraints"
    cd $td_direct_out

    td_direct_mark analyze
    import_device $td_direct_device_db -package $td_direct_package -speed $td_direct_speed
    open_project $td_direct_staged_project -single_run
    # DefaultFlow.tcl uses this command for .al single-run parameter restoration.
    load_run_param -run $td_direct_syn_run
    # SWUG105 PDF page 102: TD 6.2.2 defaults async_reg off, PH1A supports MTBF.
    set_param rtl directive:async_reg on
    report_param

    td_direct_mark elaborate
    elaborate -top $td_direct_top
    foreach td_direct_pair $td_direct_ip_adc {
        read_adc -ip [lindex $td_direct_pair 0] -file [lindex $td_direct_pair 1]
    }
    foreach td_direct_pair $td_direct_ip_sdc {
        read_sdc -ip [lindex $td_direct_pair 0] [lindex $td_direct_pair 1]
    }
    export_db ${td_direct_name}_elaborate.db

    td_direct_mark optimize_rtl
    puts "DIRECT_BUILD_POST_ANALYSIS_USER_CONSTRAINTS=[list $td_direct_adc $td_direct_sdc]"
    foreach td_direct_user_adc [lindex $td_direct_frozen_user_constraints 0] {
        td_direct_read_user_constraint adc $td_direct_user_adc
    }
    foreach td_direct_user_sdc [lindex $td_direct_frozen_user_constraints 1] {
        td_direct_read_user_constraint sdc $td_direct_user_sdc
    }
    insert_debugger
    # Native IP/OOC/debugger setup can restore switches before optimization.
    # Keep source async_reg declarations active here, not only before elaborate.
    set_param rtl directive:async_reg on
    set_param place async_reg on
    optimize_rtl
    report_area -file ${td_direct_name}_rtl.area
    export_db ${td_direct_name}_rtl.db

    td_direct_mark optimize_gate
    optimize_gate $td_direct_area_option ${td_direct_name}_gate.area
    legalize_phy_inst
    update_timing
    report_timing_status -file ${td_direct_name}_gate.ts
    report_timing_summary -file ${td_direct_name}_gate.timing
    flow_status -file gate_flow.status
    export_db ${td_direct_name}_gate.db

    td_direct_mark load_physical_parameters
    load_run_param -run $td_direct_phy_run
    # Physical strategy restoration may replace earlier RTL parameter switches;
    # keep it on before debugger OOC synthesis/merging as well as placement.
    set_param rtl directive:async_reg on
    set_param place async_reg on
    report_param

    td_direct_mark place
    insert_debugger
    set_param rtl directive:async_reg on
    set_param place async_reg on
    place
    update_timing -mode manhattan
    report_timing_status -file ${td_direct_name}_place.ts
    report_timing_summary -file ${td_direct_name}_place.timing
    report_area -io_info -file ${td_direct_name}_phy.area
    flow_status -file place_flow.status
    report_clock_utilization -file place_clock_utilization.txt
    export_db ${td_direct_name}_place.db

    td_direct_mark route
    if {$td_direct_fix_hold_high} {set_param route fix_hold high}
    route
    if {$td_direct_fix_hold_high} {
        td_direct_mark fix_hold_high
        fix_hold
    }
    report_area -io_info -file ${td_direct_name}_phy.area
    update_timing -mode final
    report_timing_status -file ${td_direct_name}_phy.ts
    report_timing_summary -file ${td_direct_name}_pr.timing
    report_timing_exception -file ${td_direct_name}_exception.timing
    check_timing -verbose -file ${td_direct_name}_chk.timing
    flow_status -file route_flow.status
    report_clock_utilization -file route_clock_utilization.txt
    set td_direct_mtbf_rc [catch {
        report_mtbf -file ${td_direct_name}_mtbf.rpt -cdc_sink_pin
    } td_direct_mtbf_message]
    set td_direct_mtbf_path [file join $td_direct_out ${td_direct_name}_mtbf.rpt]
    if {!$td_direct_mtbf_rc && [file isfile $td_direct_mtbf_path] &&
            [file size $td_direct_mtbf_path] > 0} {
        td_direct_require $td_direct_mtbf_path
        set td_direct_cdc_status CDC_REPORTED
    } else {
        set td_direct_cdc_status CDC_NOT_REPORTED
        puts "DIRECT_BUILD_CDC_NOT_REPORTED=$td_direct_mtbf_message"
    }
    set td_direct_cdc_file [open [file join $td_direct_out cdc.status] w]
    puts $td_direct_cdc_file "status=$td_direct_cdc_status"
    puts $td_direct_cdc_file "mandatory=$td_direct_mtbf_mandatory"
    puts $td_direct_cdc_file "command_return=$td_direct_mtbf_rc"
    puts $td_direct_cdc_file "message=$td_direct_mtbf_message"
    puts $td_direct_cdc_file "A produced report is not CDC sign-off; review UNDEFINED paths and coverage."
    close $td_direct_cdc_file
    if {$td_direct_mtbf_mandatory && $td_direct_cdc_status eq "CDC_NOT_REPORTED"} {
        error "MTBF is mandatory for this target, but TD produced no usable MTBF report"
    }
    export_db ${td_direct_name}_pr.db

    td_direct_mark bitgen
    # Existing phy run's compress/boot properties remain authoritative.
    bitgen -bit ${td_direct_name}.bit
    setup_debugger -prj $td_direct_name
    export_bitgen_param -file .bitgen_param.f

    td_direct_mark verify_outputs
    foreach td_direct_file [list ${td_direct_name}_elaborate.db ${td_direct_name}_rtl.db \
            ${td_direct_name}_gate.db ${td_direct_name}_place.db ${td_direct_name}_pr.db \
            ${td_direct_name}.bit ${td_direct_name}_phy.ts ${td_direct_name}_pr.timing \
            ${td_direct_name}_chk.timing] {
        td_direct_require [file join $td_direct_out $td_direct_file]
    }
    set td_direct_bit [file join $td_direct_out ${td_direct_name}.bit]
    set td_direct_compressed [file join $td_direct_out ${td_direct_name}_compress.bit]
    if {[file exists $td_direct_compressed]} {
        td_direct_require $td_direct_compressed
        set td_direct_bit $td_direct_compressed
    }
    if {[td_direct_binary $td_direct_input] ne $td_direct_before} {
        error "Source .al changed during build; inspect before accepting outputs"
    }
    set td_direct_timing [td_direct_binary [file join $td_direct_out ${td_direct_name}_phy.ts]]
    if {![regexp {SWNS:\s*([-+0-9.]+)ns} $td_direct_timing all td_direct_swns] ||
            ![regexp {HWNS:\s*([-+0-9.]+)ns} $td_direct_timing all td_direct_hwns]} {
        error "Unrecognized final setup/hold report; validation unresolved"
    }
    puts "DIRECT_BUILD_TIMING_SWNS_NS=$td_direct_swns HWNS_NS=$td_direct_hwns"
    if {$td_direct_swns < 0 || $td_direct_hwns < 0} {
        error "Diagnostic bit generated; final setup/hold failed"
    }
    td_direct_mark complete
    puts "DIRECT_BUILD_COMPLETE=$td_direct_out"
    puts "DIRECT_BUILD_BIT=$td_direct_bit"
    puts "DIRECT_BUILD_CDC_STATUS=$td_direct_cdc_status"
    puts "Review clock coverage, CDC, warnings and live board behavior separately."
} td_direct_error]} {
    puts stderr "DIRECT_BUILD_FAILED_STAGE=$td_direct_stage"
    puts stderr "DIRECT_BUILD_OUTPUT=$td_direct_out"
    puts stderr $td_direct_error
    if {[info exists ::errorInfo]} {puts stderr $::errorInfo}
    exit 1
}
exit 0
