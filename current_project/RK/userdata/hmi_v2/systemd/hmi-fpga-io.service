[Unit]
Description=HMI fpga-io
PartOf=hmi.target
After=

[Service]
Type=simple
WorkingDirectory=/userdata/hmi_v2
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/linaro/.Xauthority
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/userdata/gaze_model_migration_v1_20261014/app_venv/bin/python -m core.io_service
Restart=no
RestartSec=2
TimeoutStopSec=25
KillMode=control-group
CPUAffinity=4
UMask=0077
RuntimeDirectory=hmi
RuntimeDirectoryPreserve=yes
LimitRTPRIO=10

[Install]
WantedBy=hmi.target
