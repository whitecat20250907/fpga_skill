+/* Process context only, with no engine spinlock held. The synchronous submit
+ * caller keeps desc_lock and its request/SG mappings until this returns.
+ * A signal or deadline is not permission to free memory still owned by DMA. */
+static void engine_wait_stopped(struct anlogic_dma_engine *engine)
+{
+	unsigned long flags;
+	unsigned long warn_after = jiffies + HZ;
+	u32 status, control;
+
+	for (;;) {
+		spin_lock_irqsave(&engine->lock, flags);
+		status = read_register(&engine->regs->status);
+		control = read_register(&engine->regs->control);
+		if (!(status & SGDMA_STAT_BUSY) &&
+		    !(control & SGDMA_CTRL_RUN_STOP)) {
+			struct sgdma_poll_wb *wb_data =
+				(struct sgdma_poll_wb *)engine->poll_mode_addr_virt;
+
+			/* Engine idle is distinct from the software poll generation. */
+			dma_rmb();
+			if (wb_data) {
+				WRITE_ONCE(wb_data->completed_desc_count, 0);
+				dma_wmb();
+			}
+			engine->dma_quiescing = false;
+			spin_unlock_irqrestore(&engine->lock, flags);
+			return;
+		}
+		spin_unlock_irqrestore(&engine->lock, flags);
+		if (time_after(jiffies, warn_after)) {
+			pr_err_ratelimited("%s: STOP not confirmed (status=0x%08x control=0x%08x); retaining DMA mappings until RUN=0/BUSY=0\n",
+					   engine->name, status, control);
+		}
+		/* Deliberately uninterruptible: returning would let a killed reader
+		 * or STREAMOFF release an externally owned vb2/user buffer. */
+		usleep_range(1000, 2000);
+	}
 }
 
